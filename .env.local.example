# Resend API Key — get this from https://resend.com/api-keys
# Add this to Vercel: Settings → Environment Variables → RESEND_API_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BabyLoveGrowth API Key — Settings → Integrations → Developer → API
# Add this to Vercel: Settings → Environment Variables → BABYLOVEGROWTH_API_KEY
BABYLOVEGROWTH_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Bearer token BabyLoveGrowth's webhook sends us — invent a random string,
# enter it here AND in BabyLoveGrowth's webhook wizard (Settings → Integrations → Webhook)
# Add this to Vercel: Settings → Environment Variables → BABYLOVEGROWTH_WEBHOOK_SECRET
BABYLOVEGROWTH_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude Code routine API trigger token — generated once at claude.ai/code/routines
# on the "Statera BabyLoveGrowth Daily Publish" routine's "Call via API" trigger.
# Shown only once at generation time, so save it immediately.
# Add this to Vercel: Settings → Environment Variables → CLAUDE_ROUTINE_TOKEN
CLAUDE_ROUTINE_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
