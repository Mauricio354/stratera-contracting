# Resend API Key — get this from https://resend.com/api-keys
# Add this to Vercel: Settings → Environment Variables → RESEND_API_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BabyLoveGrowth API Key — Settings → Integrations → Developer → API
# Add this to Vercel: Settings → Environment Variables → BABYLOVEGROWTH_API_KEY
BABYLOVEGROWTH_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
